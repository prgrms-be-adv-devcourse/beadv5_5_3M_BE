{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3UploadsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetObjectAcl",
        "s3:PutObjectAcl"
      ],
      "Resource": [
        "arn:aws:s3:::beadv5-uploads-1",
        "arn:aws:s3:::beadv5-uploads-1/*"
      ]
    }
  ]
}
