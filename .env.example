# ──────────────────────────────────────────
# Docker Hub
# ──────────────────────────────────────────
DOCKERHUB_USERNAME=

# ──────────────────────────────────────────
# Kafka (외부 AWS 브로커)
# ──────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=52.78.88.98:9092

# ──────────────────────────────────────────
# Redis (EC2에서 별도 관리)
# ──────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379

# ──────────────────────────────────────────
# AWS S3 (user-service 파일 저장소)
# ──────────────────────────────────────────
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=

# ──────────────────────────────────────────
# PostgreSQL (EC2에서 별도 관리)
# ──────────────────────────────────────────
DB_HOST=
DB_USERNAME=
DB_PASSWORD=

# ──────────────────────────────────────────
# Gateway 라우팅 대상 호스트
# - EC2 단일 서버: EC2 인스턴스의 내부 IP 또는 127.0.0.1
# ──────────────────────────────────────────
BASE_IP=

# ──────────────────────────────────────────
# 서비스 포트
# ──────────────────────────────────────────
GATEWAY_PORT=8000
CREATOR_PORT=8080
PAYMENT_PORT=8081
SETTLEMENT_PORT=8083
TICKET_PORT=8084
USER_PORT=8085
MOVIE_PORT=8086
STREAMING_PORT=8088
AI_PORT=8089

# ──────────────────────────────────────────
# JWT (creator-service·user-service 발급 / gateway-service 검증)
# - RSA 키페어: JWT_PRIVATE_KEY(발급), JWT_PUBLIC_KEY(검증)
# - JWT_TOKEN_PUBLIC: gateway에서 서명 검증에만 사용하는 공개키
# ──────────────────────────────────────────
JWT_TOKEN_PUBLIC=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=604800

# ──────────────────────────────────────────
# MinIO / S3 호환 파일 저장소 (user-service)
# - 로컬: MinIO 엔드포인트 직접 지정
# - 운영(AWS S3): MINIO_ENDPOINT 비워두면 기본 AWS 엔드포인트 사용
# ──────────────────────────────────────────
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# ──────────────────────────────────────────
# Google OAuth (user-service / GoogleOAuthService)
# - Google Cloud Console → OAuth 2.0 Client IDs 에서 발급
# - REDIRECT_URI 는 Google 콘솔에 등록된 값과 정확히 일치해야 함
# ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ──────────────────────────────────────────
# SMTP Mail (user-service / JavaMailSender)
# - Gmail SMTP 사용 시 MAIL_PASSWORD 는 앱 비밀번호(App Password) 사용
# ──────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ──────────────────────────────────────────
# Toss Payments (payment-service)
# ──────────────────────────────────────────
TOSS_PAYMENT_SECRET=
TOSS_PAYMENT_CK=

# ──────────────────────────────────────────
# Settlement (settlement-service 정산 설정)
# ──────────────────────────────────────────
SETTLEMENT_FEE_RATE=0.10
SETTLEMENT_COOKIE_TO_KRW_RATE=100
SETTLEMENT_DLQ_FALLBACK_PATH=/tmp/settlement-dlq-fallback.jsonl
SETTLEMENT_DLQ_MAX_RETRY=3

# ──────────────────────────────────────────
# OpenAI (ai-service)
# - 임베딩·요약·리랭킹에 사용. 모델명은 ai-service application-prod.yaml 기본값 사용.
# ──────────────────────────────────────────
OPENAI_API_KEY=

# ──────────────────────────────────────────
# Streaming (streaming-service)
# - JWT_SECRET: sessionToken 서명 비밀 (HS256)
# - ADDRESS_ADAPTER: HLS 주소 해석 전략 (local-direct 기본)
# - PUBLIC_BASE_URL: HLS 매니페스트가 가리키는 외부 접근 URL
# - KAFKA_CONSUMER_GROUP_ID_STREAMING: streaming 전용 consumer group
# - CLIENT_CREATOR_BASE_URL: creator-service 내부 호출 URL
# - STORAGE_S3_PATH: HLS 산출물(.m3u8/.ts) 베이스 디렉토리
# ──────────────────────────────────────────
STREAMING_JWT_SECRET=
STREAMING_ADDRESS_ADAPTER=local-direct
STREAMING_PUBLIC_BASE_URL=
KAFKA_CONSUMER_GROUP_ID_STREAMING=streaming-service
CLIENT_CREATOR_BASE_URL=
STORAGE_S3_PATH=

# ──────────────────────────────────────────
# Movie Service — Elasticsearch 토글
# - false: MovieSearchService·MovieSearchRepository 비활성화 → JPA LIKE fallback (ES 인프라 없을 때)
# - true : ES 검색·자동완성·하이라이트 사용 (ES_URIS 도 같이 설정 필요)
# ──────────────────────────────────────────
MOVIE_ES_ENABLED=false
ES_URIS=http://localhost:9200

# ──────────────────────────────────────────
# Spring JPA DDL 정책
# - validate: 스키마 검증만 (운영 기본값)
# - update:   변경 자동 반영 (개발용)
# - create:   테이블 재생성 (초기 구축용, 데이터 삭제 주의)
# ──────────────────────────────────────────
DDL_AUTO=validate